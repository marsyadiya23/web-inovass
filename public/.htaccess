# Apache (cPanel) config for the site
Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# CMS Laravel (jadwal & pendaftaran pelatihan, admin) ada di public_html/inovass/public.
# Alamat ini diteruskan ke CMS; sisanya tetap situs statis. livewire-xxxx & filament = endpoint internal admin.
RewriteRule ^(jadwal-pelatihan|pelatihan|admin|filament|livewire-[^/]+)(/.*)?$ inovass/public/index.php [L]

# Clean URLs: /tentang -> tentang.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options SAMEORIGIN
  Header always set Referrer-Policy strict-origin-when-cross-origin
  # CSS/JS have no hashed filenames, so browsers revalidate to pick up deploys
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

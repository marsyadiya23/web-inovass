// Cloudflare Workers Builds runs `npx wrangler deploy` on every push to main.
// Static site only: serve public/ as assets, no Worker script.
{
  "name": "web-inovass",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public"
  },
  "workers_dev": true,   // https://web-inovass.<account-subdomain>.workers.dev
  "preview_urls": true   // non-main branches get their own preview URL
}
